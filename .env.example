# Copy to .env.local and fill in from your Supabase project:
# Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth (Dashboard > Authentication > URL Configuration):
# - Site URL: your production app URL (e.g. https://ccexpedition.vercel.app)
# - Redirect URLs: production URL, http://localhost:5173/**, http://localhost:5174/**

# Public site URL for Open Graph / WhatsApp preview (optional on Vercel; VERCEL_URL is used as fallback)
# VITE_SITE_URL=https://ccexpedition.vercel.app
